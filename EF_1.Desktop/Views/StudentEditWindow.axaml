<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EF_1.Desktop.ViewModels"
        xmlns:models="using:EF_1.Desktop.Models"
        x:Class="EF_1.Desktop.Views.StudentEditWindow"
        x:DataType="vm:StudentEditViewModel"
        Title="{Binding WindowTitle}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="6">

        <TextBlock Text="ФИО" />
        <TextBox Text="{Binding FullName}"
                 PlaceholderText="Иванов Иван Иванович" />
        <TextBlock Text="{Binding FullNameError}"
                   IsVisible="{Binding HasFullNameError}"
                   Foreground="Red"
                   TextWrapping="Wrap" />

        <TextBlock Text="Возраст" Margin="0,8,0,0" />
        <TextBox Text="{Binding Age}"
                 PlaceholderText="От 1 до 120" />
        <TextBlock Text="{Binding AgeError}"
                   IsVisible="{Binding HasAgeError}"
                   Foreground="Red"
                   TextWrapping="Wrap" />

        <TextBlock Text="Email" Margin="0,8,0,0" />
        <TextBox Text="{Binding Email}"
                 PlaceholderText="name@example.com" />
        <TextBlock Text="{Binding EmailError}"
                   IsVisible="{Binding HasEmailError}"
                   Foreground="Red"
                   TextWrapping="Wrap" />

        <TextBlock Text="Куратор" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Teachers}"
                  SelectedItem="{Binding SelectedTeacher}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:TeacherOption">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{Binding FormError}"
                   IsVisible="{Binding HasFormError}"
                   Foreground="Red"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Сохранить"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
            <Button Content="Отмена"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>